# Telegram Bot Token (required, from @BotFather)
TG_TOKEN=your_telegram_bot_token

# SOCKS5 proxy URL (optional, for restricted networks)
TG_PROXY=socks5://127.0.0.1:9150

# OmniRoute API endpoint (required)
OMNIROUTE_BASE_URL=https://omniroute.example.com/v1

# Model to use (optional, defaults to kr/claude-sonnet-4.5)
OMNIROUTE_MODEL=kr/claude-sonnet-4.5

# OmniRoute API key (required - bot will not start without it)
OMNIROUTE_API_KEY=your_omniroute_api_key

# Comma-separated user IDs for private chat access (optional)
ALLOWED_USERS=

# Optional default channel for scheduled news posts.
# Public channels: numeric ID (e.g. -1001234567890) or @username.
# Private channels: numeric ID only. The bot must be an admin with Post messages permission.
NEWS_CHANNEL_ID=

# IANA timezone for scheduled news posts (optional)
NEWS_TIMEZONE=Europe/Moscow

# Maximum number of scheduled news jobs (optional, positive integer)
NEWS_MAX_JOBS=20

# Optional numeric user ID for scheduled publication failure notifications
ADMIN_USER_ID=
